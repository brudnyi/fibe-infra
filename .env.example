# Domains
ROOT_DOMAIN=fibe.pro
WWW_DOMAIN=www.fibe.pro
ADMIN_DOMAIN=admin.fibe.pro
CABINET_DOMAIN=cabinet.fibe.pro
API_DOMAIN=api.fibe.pro

# Container images
BACKEND_IMAGE=ghcr.io/akbarbiinazar/fibe-backend:latest
ADMIN_IMAGE=ghcr.io/akbarbiinazar/fibe-admin:latest
LANDING_IMAGE=ghcr.io/akbarbiinazar/fibe-landing:latest
ORGANIZER_CABINET_IMAGE=ghcr.io/fibe-pro/fibe-organizer-cabinet:latest

# Organizer cabinet build-time config (used only on local `docker compose build`;
# CI bakes these into the published image via build-args).
ORGANIZER_CABINET_API_BASE_URL=https://api.fibe.pro
ORGANIZER_CABINET_GOOGLE_MAPS_API_KEY=

# Landing build-time config (used only on local `docker compose build`; CI bakes
# this into the published image via a build-arg). Where the landing's "Создать
# событие" buttons redirect — the organizer cabinet public form.
PUBLIC_ORGANIZER_FORM_URL=https://cabinet.fibe.pro/new

# App runtime
NODE_ENV=production
MODE=PROD
PORT=3001
CORS_ORIGINS=https://admin.fibe.pro,https://cabinet.fibe.pro
APP_AUTH_ACTION_URL=https://fibe.pro/api/auth-action
EVENTS_API_BASE_URL=https://api.fibe.pro

# PostgreSQL (system service)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=fibe_user
POSTGRES_PASSWORD=change_me
POSTGRES_DATABASE=fibe_db
POSTGRES_SSL=false

# Secrets
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me
CLOUDINARY_NAME=change_me
CLOUDINARY_KEY=change_me
CLOUDINARY_SECRET=change_me
