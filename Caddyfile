{$ROOT_DOMAIN} {
  encode gzip zstd

  @policyExact path /policy
  redir @policyExact /policy/ 308

  handle_path /policy/* {
    root * /srv/policy
    try_files {path} /index.html
    file_server
    header {
      X-Content-Type-Options nosniff
      X-Frame-Options SAMEORIGIN
      Referrer-Policy strict-origin-when-cross-origin
    }
  }

  respond 404
}

{$ADMIN_DOMAIN} {
  encode gzip zstd
  reverse_proxy admin:80
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options SAMEORIGIN
    Referrer-Policy strict-origin-when-cross-origin
  }
}

{$API_DOMAIN} {
  encode gzip zstd
  reverse_proxy backend:3001
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options SAMEORIGIN
    Referrer-Policy strict-origin-when-cross-origin
  }
}
